# Node 24 standalone example: copy to a private file OUTSIDE this repository.
# Fill in the SHA-256 hex digest of a high-entropy personal admin passphrase.
# The raw passphrase and digest must not be committed.
HGP_ADMIN_HASH=
HGP_PUBLIC_ORIGIN=http://127.0.0.1:5189
PORT=5189
# Replace with an absolute, private, persistent path outside the checkout.
HGP_DATABASE_PATH=
# Sites only needs HGP_ADMIN_HASH as a runtime secret; do not upload this file.
